{
  "manifestVersion": 1,
  "id": "azure-devops-gitflow-extension",
  "publisher": "AliGhelichkhani",
  "version": "0.0.1",
  "name": "Azure DevOps GitFlow Extension",
  "description": "Adds GitFlow UI to Azure DevOps Repos",
  "categories": [ "Azure Repos" ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "icon.png"
  },
  "contributions": [
    {
      "id": "gitflow-repo-tab",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-code-web.code-hub-group"
      ],
      "properties": {
        "name": "GitFlow",
        "uri": "index.html",
        "icon": "menu-icon.png"
      }
    }
  ],
  "files": [
    { "path": "index.html", "addressable": true },
    { "path": "main.js","addressable": true },
    { "path": "style.css","addressable": true },
    { "path": "icon.png","addressable": true },
    { "path": "menu-icon.png", "addressable": true }
  ]
}